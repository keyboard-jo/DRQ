# pyenv
#   For a library or package, you might want to ignore .python-version file, but for
#   applications it is often desirable to check it in. See https://github.com/pyenv/pyenv#python-version
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to checkin Pipfile.lock into version control.
#   However, accelerated builds may cause issues if locks are out of sync.
Pipfile.lock

# Poetry
#   Similar to Pipfile.lock, it is generally recommended to checkin poetry.lock into version control.
poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to checkin pdm.lock into version control.
pdm.lock
.pdm.toml

# PEP 582; used by e.g. hatch, PDM, and local virtual environments
